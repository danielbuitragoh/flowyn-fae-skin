# ===========================================================================
# flowyn · FAE SKIN — variables de entorno
# ===========================================================================
#
# Copia este archivo como `.env` y rellena los dos valores. `.env` está en
# `.gitignore` y no se sube nunca.
#
#   cp .env.example .env
#
# Sin estas variables el sitio funciona igual, pero sin cuenta: el carrito
# se guarda sólo en el navegador y el botón de entrar no aparece. Es
# deliberado — una tienda a medio conectar es peor que una tienda honesta.
# ---------------------------------------------------------------------------

# Panel de Supabase → Project Settings → Data API → Project URL
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Panel de Supabase → Project Settings → API Keys → `anon` / `publishable`
#
# Esta llave está pensada para viajar en el navegador: no da más permisos que
# los que concedan las políticas RLS de la base. Por eso puede acabar en el
# paquete construido sin que eso sea una filtración.
#
# La que NO va aquí nunca es la `service_role`. Esa salta todas las políticas
# y sólo vive dentro de una función de servidor.
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
